// weft.cat — Formal memory model for the Weft Triad & Fan-Out Protocol (ARMv8-A)
// Compatible with herd7 / herdtools7 axiomatic memory model checker.
//
// Models:
// 1. Triad Kernel: Writer payload store -> canary store -> atomic exchange (Release/AcqRel)
//                  Reader atomic exchange (Acquire/AcqRel) -> canary load -> payload load
// 2. Fan-out Ring: Writer slot invalidation -> payload store -> slot stamp (Release) -> latestSeq (Release)
//                  Reader latestSeq (Acquire) -> slot stamp (Acquire) -> payload read -> post-stamp (Acquire)
//
// Proves:
// - Coherence (sc-per-loc): Acyclicity of (po-loc | rf | co | fr)
// - Invariant I1 (No Torn Reads): Reader never observes partially written payload
// - Invariant I6 (No Use-After-Free): Writer never overwrites held slot without prior reader exchange

"Weft-ARMv8-Axiomatic"

// --- Event classes ---
enum MemOp = 'R' + 'W' + 'F'
enum Tag = 'Plain' + 'Acquire' + 'Release' + 'AcqRel' + 'Atomic'

// --- Base relations ---
let po-loc = po & loc
let rfe = rf & ext
let rfi = rf & int
let coe = co & ext
let coi = co & int
let fre = fr & ext
let fri = fr & int

// --- Barrier and Ordering semantics (ARMv8 AArch64) ---
let dmb-ish   = [F & 'DMB.ISH']
let dmb-ishld = [F & 'DMB.ISHLD']
let dmb-ishst = [F & 'DMB.ISHST']

let is-release = 'Release' + 'AcqRel'
let is-acquire = 'Acquire' + 'AcqRel'

let Rel = [M & is-release]
let Acq = [M & is-acquire]

// Release-Acquire Synchronization paths
let fence-rel = (po & (M * [dmb-ish | dmb-ishst])) ; po
let fence-acq = (po & ([dmb-ish | dmb-ishld] * M)) ; po

// Ordered-before on ARMv8
let obs-rel = (Rel | fence-rel)
let obs-acq = (Acq | fence-acq)

// Cross-thread synchronization edge: Release -> Read-From -> Acquire
let sw = (obs-rel & (M * W)) ; rfe ; (obs-acq & (R * M))

// Preserved program order (data dependencies, control dependencies, barriers)
let ppo = (po & (R * R) & (data | ctrl)) |
          (po & (R * W) & (data | ctrl | addr)) |
          (po & (W * W) & (data | addr)) |
          (po & (Rel * M)) |
          (po & (M * Acq)) |
          fence-rel | fence-acq

// Happens-before relation
let hb = (ppo | sw)+

// --- Core Consistency Axioms ---

// 1. SC-per-location (Coherence of individual memory addresses)
acyclic (po-loc | rf | co | fr) as Coherence

// 2. Happens-before consistency (No causality cycles)
irreflexive (hb ; (rf | fr | co)) as ObservationConsistency

// 3. Atomicity of Triad & Fan-out Exchanges (Atomicity of RMW operations)
empty (rmw & (fre ; coe)) as AtomicExchangeIntegrity

// 4. Weft Invariant I1 (No Torn Reads):
// For any payload read R_payload and writer's payload write W_payload,
// if reader observes the publication exchange, then W_payload hb R_payload.
let triad-published = (W & 'Payload') ; po ; (W & 'Canary') ; po ; (W & 'ExchangeRel')
let triad-claimed   = (R & 'ExchangeAcq') ; po ; (R & 'Canary') ; po ; (R & 'Payload')

let weft-triad-sync = triad-published ; rfe ; triad-claimed
assert (weft-triad-sync <= hb) as InvariantI1_NoTornReads
